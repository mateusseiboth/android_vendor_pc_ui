<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Top status bar of the desktop: clock, date and the notifications chip (icons of the
         notifying apps) on the left; quick settings chip on the right. Needs the
         status_bar_for_desktop and scene_container flags; the notifications chip at the start is
         ours (pc branch of frameworks/base). -->
    <bool name="config_useDesktopStatusBar">true</bool>
    <bool name="config_desktopStatusBarNotificationsAtStart">true</bool>
    <bool name="config_statusBarTapToExpandShade">true</bool>
    <bool name="config_enableTwoFingerSwipeDownShade">false</bool>
    <bool name="config_isStatusBarConnectedDisplayChipEnabled">false</bool>
    <bool name="config_largeScreenPrivacyIndicator">true</bool>

    <!-- Notifications and quick settings are popups under the status bar, with no separate full
         screen shade scenes: notifications at the top start, under their chip, quick settings at
         the top end. The notifications popup draws its own empty state (pc branch of
         frameworks/base). -->
    <bool name="config_notificationShadeOnTopEnd">false</bool>
    <bool name="config_composeEmptyNotificationShade">true</bool>
    <bool name="config_includeQSAndShadeScenes">false</bool>
    <bool name="config_disableDualShadeEducationalTooltips">true</bool>
    <bool name="config_enableHideNotificationsShadeOnAllAppsKey">true</bool>
    <bool name="config_enableHUNExpansion">true</bool>

    <!-- Quick settings: infinite grid, power menu inline in the toolbar, brightness dialog at the
         end side, audio details in the tile. -->
    <bool name="config_useInfiniteGridLayoutAsDefault">true</bool>
    <bool name="config_qsInlinePowerMenu">true</bool>
    <bool name="config_useBrightnessMirrorInOverlay">false</bool>
    <bool name="config_endSideBrightnessDialog">true</bool>
    <bool name="config_enableDesktopAudioTileDetailsView">true</bool>
    <string name="quick_settings_tiles_default" translatable="false">internet,bt,cast,screenrecord,dnd,mictoggle,cameratoggle,dark,ime,rotation</string>

    <!-- A desktop: mouse and keyboard input, no blurred wallpaper, opaque power menu. -->
    <bool name="config_isDesktopForFalsingPurposes">true</bool>
    <bool name="config_enableInputRouting">true</bool>
    <bool name="config_supportBlurredWallpaper">false</bool>
    <bool name="config_translucentStandalonePowerMenu">false</bool>

    <!-- Window header theme (light or dark) from the topmost opaque activity, not from a
         translucent one on top (pc branch of frameworks/base). -->
    <bool name="config_windowDecorThemeFromTopOpaqueBackground">true</bool>

    <!-- A click on the status bar clock opens the calendar popup (pc branch of frameworks/base). -->
    <bool name="config_statusBarClockOpensCalendar">true</bool>

    <!-- Screen capture: the large screen toolbar (screenshot or recording of the screen, a window
         or a region; the screenrecord tile opens it). New recordings go to Movies/Screen
         recordings (capture branch of frameworks/base). -->
    <bool name="config_enableLargeScreenScreencapture">true</bool>
    <string name="config_screenRecordingFolder" translatable="false">Movies/Screen recordings</string>

    <!-- Plugins SystemUI loads on user builds: itself and the lock screen clock styles of
         packages/apps/PcClocks. -->
    <string-array name="config_pluginAllowlist" translatable="false">
        <item>com.android.systemui</item>
        <item>com.android.systemui.clocks.bignum</item>
        <item>com.android.systemui.clocks.calligraphy</item>
        <item>com.android.systemui.clocks.growth</item>
        <item>com.android.systemui.clocks.inflate</item>
        <item>com.android.systemui.clocks.metro</item>
        <item>com.android.systemui.clocks.numoverlap</item>
        <item>com.android.systemui.clocks.weather</item>
    </string-array>

    <!-- Heads-up notifications as cards at the top end of the screen, 20 s each (hovering
         restarts that once), stacked up to 4, staying in the notifications list afterwards; with
         several monitors on the display the user works on (pc branch of frameworks/base). -->
    <bool name="config_desktopHeadsUpCards">true</bool>
    <integer name="config_desktopHeadsUpTimeoutMs">20000</integer>
    <integer name="config_desktopHeadsUpMaxCards">4</integer>
    <bool name="config_shadeFollowsFocusedDisplay">true</bool>

    <!-- Lock screen of a desktop. -->
    <bool name="config_improveLargeScreenInteractionOnLockscreen">true</bool>
    <bool name="config_disableNotificationShelfOnKeyguard">true</bool>
    <bool name="config_showAccessibilityButtonOnBouncer">true</bool>
    <integer name="config_lockScreenDisplayTimeout">60000</integer>
</resources>
